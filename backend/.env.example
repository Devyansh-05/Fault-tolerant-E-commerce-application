# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
FRONTEND_URL=http://localhost:5173

# --- MongoDB Atlas --------------------------------------------------------
# Atlas > Database > Connect > Drivers > Node.js. Replace <username>/<password>
# with your Atlas DATABASE user (not your Atlas login). URL-encode special characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB_NAME=ecommerce
# Used only by `npm test`; the test-suite drops this database. Must contain "test".
MONGODB_TEST_DB_NAME=ecommerce_test

# --- Authentication -------------------------------------------------------
# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Redis (Docker) -------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# The bundled docker-compose Redis has no password (it only listens on localhost).
REDIS_PASSWORD=
REDIS_KEY_PREFIX=ecom

# --- HTTP idempotency -----------------------------------------------------
# Lifetime of a PROCESSING lock (crash recovery window), in seconds
IDEMPOTENCY_PROCESSING_TTL_SECONDS=60
# How long COMPLETED/FAILED responses are cached in Redis for replay, in seconds
IDEMPOTENCY_RECORD_TTL_SECONDS=86400

# --- RabbitMQ (Docker) ----------------------------------------------------
# Matches the development user created by docker-compose.yml (RABBITMQ_USER / RABBITMQ_PASSWORD).
RABBITMQ_URL=amqp://ecommerce:ecommerce_dev@127.0.0.1:5672
RABBITMQ_EXCHANGE=ecommerce.events
RABBITMQ_QUEUE_PREFIX=ecommerce
# Max unacknowledged messages per consumer (bounded concurrency)
RABBITMQ_PREFETCH=10
RABBITMQ_CONFIRM_TIMEOUT_MS=5000

# --- Reliable Event Processor: retry / DLQ -------------------------------
# Attempt 1 is the first execution; MAX_RETRIES more attempts follow (max 1 + MAX_RETRIES).
# Delay before retry n = min(INITIAL_RETRY_DELAY_MS * RETRY_BACKOFF_MULTIPLIER^(n-1), MAX_RETRY_DELAY_MS)
MAX_RETRIES=3
INITIAL_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=10000
RETRY_BACKOFF_MULTIPLIER=2
# A handler running longer than this counts as a (transient) timeout failure
EVENT_PROCESSING_TIMEOUT_MS=10000
# Redis processing lease (must be > EVENT_PROCESSING_TIMEOUT_MS); expires if a consumer crashes
EVENT_LEASE_MS=20000
# How long Redis remembers COMPLETED events (MongoDB keeps the durable record permanently)
EVENT_IDEMPOTENCY_TTL_SECONDS=604800

# --- Outbox Publisher -----------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
# A PUBLISHING claim older than this is considered abandoned and re-claimed
OUTBOX_CLAIM_TIMEOUT_MS=15000
OUTBOX_MAX_BACKOFF_MS=10000

# --- Simulated payment gateway -------------------------------------------
# Orders with a total above this amount (INR) are declined -> PAYMENT_FAILED
SIMULATED_PAYMENT_DECLINE_ABOVE=500000

# --- Stage 3: Fault Injection & Synthetic Event Generator (optional) -----
# Admin testing tools. ALWAYS disabled when NODE_ENV=production, whatever this says.
# Every individual fault is off until an admin enables it in the Testing Panel.
FAULT_INJECTION_ENABLED=true
# Upper limits accepted by the fault configuration API
FAULT_MAX_DELAY_MS=30000
FAULT_MAX_FAILURE_COUNT=100
FAULT_MAX_DUPLICATE_COPIES=5
# Maximum synthetic events per "Generate events" request
TEST_EVENT_MAX_BATCH=200

# --- Seed script: initial administrator (optional) ------------------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
