{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Fault-tolerant e-commerce backend (Express + MongoDB Atlas + Redis idempotency)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch worker.js",
    "publisher": "node worker.js publisher",
    "consumer:payment": "node worker.js payment",
    "consumer:inventory": "node worker.js inventory",
    "consumer:order": "node worker.js order",
    "consumer:email": "node worker.js email",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "redis": "^4.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
